generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id                              String @id @default(uuid())
  avatar                          String
  fullName                        String
  userName                        String @unique
  email                           String @unique
  password                        String
  role                            Role @default(CLIENT)
  orders                          Order[]
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
}
enum Role {
  CLIENT
  ADMIN
}
model Order {
  id            Int               @id @default(autoincrement())
  userId        String
  createdAt     DateTime          @default(now())
  weightKg      Float
  price         Float
  user          User              @relation(fields: [userId], references: [id])
  trackingCode  String            @unique
  read          Boolean           @default(false)
  status        OrderStatus       @default(CREATED)

  fromCityId    String
  toCityId      String
  fromCity      AllService         @relation("FromCity", fields: [fromCityId], references: [id])
  toCity        AllService         @relation("ToCity", fields: [toCityId], references: [id])

  serviceTypeId String
  serviceType   ServiceType        @relation(fields: [serviceTypeId], references: [id])
 

}
enum OrderStatus {
  CREATED    
  IN_TRANSIT 
  DELIVERED   
  CANCELED     
}
model ServiceType {
  id              String          @id @default(uuid())
  name            String
  code            String          @unique
  description     Json        
  deliveryTime    String      
  pricekg         Float
  priceKm         Float
  orders          Order[]
}
model AllService {
  id              String   @id @default(uuid())
  name            String   @unique
  lat             Float
  lon             Float

  orderFrom       Order[]  @relation("FromCity")
  orderTo         Order[]  @relation("ToCity")
}