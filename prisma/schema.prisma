
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  avatar String
  fullName String
  userName String @unique
  email String @unique
  password String
  role Role @default(CLIENT)
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum Role {
  CLIENT
  ADMIN
}
model Order {
  id            Int              @id @default(autoincrement())
  userId        String
  trackingCode  String           @unique
  fromCity      String
  toCity        String
  distanceKm    Float
  weightKg      Float
  serviceType   String
  price         Float
  read          Boolean
  status        OrderStatus       @default(CREATED)
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id])
}


enum OrderStatus {
  CREATED    
  IN_TRANSIT 
  DELIVERED   
  CANCELED     
}

model ServiceType {
  id              String      @id @default(uuid())
  name            String
  code            String      @unique
  description     String      
  deliveryTime    String      
  price           Float
  imageUrl        String
}